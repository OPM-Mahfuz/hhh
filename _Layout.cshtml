<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - Refugee Appointment System</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><header class="top"><div class="brand"><div class="seal">OPM</div><div><strong>Refugee Online Appointment System</strong><small>Appointment scheduling and tracking</small></div></div><nav><a asp-controller="Home" asp-action="Index">Appointment lookup</a><a asp-controller="Staff" asp-action="Index">Staff portal</a></nav></header><main class="container">@if (TempData["Notice"] is string notice) { <div class="notice">@notice</div> } @RenderBody()</main><footer>For appointment assistance, contact your designated registration centre. Do not share your personal details with unauthorized persons.</footer>@await RenderSectionAsync("Scripts", required: false)</body></html>
