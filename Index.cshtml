@model List<Appointment>
@{ ViewData["Title"] = "Staff dashboard"; }
<section class="hero"><p class="eyebrow">AUTHORIZED PERSONNEL ONLY</p><h1>Appointment administration</h1><p>Manage appointments and monitor the daily schedule. Access is restricted to approved staff accounts.</p></section>
<div class="stats"><div class="stat"><span>Active individuals</span><strong>@ViewBag.People</strong></div><div class="stat"><span>Appointments today</span><strong>@ViewBag.Today</strong></div><div class="stat"><span>Upcoming scheduled</span><strong>@ViewBag.Pending</strong></div></div>
<div class="toolbar"><div><h2>Appointment schedule</h2><p class="muted">Showing up to 200 appointments, earliest first.</p></div><div class="actions"><a class="button" asp-action="CreateAppointment">Create appointment</a><a class="button secondary" asp-action="CreateIndividual">Add individual</a></div></div>
<div class="table-wrap"><table><thead><tr><th>Person</th><th>Group / Individual No.</th><th>Service</th><th>Date and time</th><th>Location</th><th>Status</th><th>Update</th></tr></thead><tbody>
@foreach (var a in Model) { <tr><td>@a.Individual?.FullName</td><td>@a.Individual?.GroupNumber<br/><span class="muted small">@a.Individual?.IndividualNumber</span></td><td>@a.ServiceName</td><td>@a.AppointmentDateTime.ToString("dd MMM yyyy HH:mm")</td><td>@a.Location</td><td><span class="status">@a.Status</span></td><td><form asp-action="UpdateStatus" method="post" class="inline-form"><input type="hidden" name="id" value="@a.Id"/><select name="status" aria-label="Appointment status"><option>Scheduled</option><option>Arrived</option><option>Served</option><option>Absent</option><option>Rescheduled</option><option>Cancelled</option></select><button class="button tiny" type="submit">Save</button></form></td></tr> }
</tbody></table></div>
